# Copy to .env. The sandbox Spark Connect server (parked compose) listens here.
# Start it with:
#   cd ~/Documents/spark_content/spark_42_demos
#   docker compose -p spark42demos -f compose/docker-compose.yml up -d
SPARK_REMOTE=sc://localhost:15099

# Optional: force a purely local SparkSession instead of Connect (metric-view DDL
# needs a 4.2 server, but the "naive lie" half runs on any local Spark 4.x).
# SPARK_LOCAL=1
