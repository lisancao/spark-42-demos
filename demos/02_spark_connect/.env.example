# Copy to .env to change the defaults, which match the documentation.

# Spark Connect gRPC port, and the URL clients use to reach it
CONNECT_PORT=15002
SPARK_REMOTE=sc://localhost:15002

# Standalone master web UI
MASTER_UI_PORT=8080

# Connect server (driver) web UI
CONNECT_UI_PORT=4040

# Spark 4.1.2 Connect server used by `make matrix`
CONNECT_41_PORT=15096

# Set to local[*] to run the Connect server without the worker
CONNECT_MASTER=spark://spark-master:7077
